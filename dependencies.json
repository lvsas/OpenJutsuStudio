{
  "schema": 1,
  "note": "What this application needs on a ComfyUI machine. Verified against a live /object_info rather than assembled from memory. Folders are ComfyUI's own model directories.",
  "verified_against": {
    "comfyui": "0.40.0",
    "date": "2026-10-18"
  },
  "comfyui_packs": [
    {
      "name": "ComfyUI-VideoHelperSuite",
      "source": "https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite",
      "nodes": ["VHS_LoadVideo", "VHS_VideoCombine"],
      "used_by": ["ltx-ripple", "ltx-frame-edit", "h3-recast"],
      "required": true
    },
    {
      "name": "ComfyUI-LTXVideo",
      "source": "https://github.com/Lightricks/ComfyUI-LTXVideo",
      "nodes": ["LTXAddVideoICLoRAGuide"],
      "used_by": ["ltx-ripple"],
      "required": true
    },
    {
      "name": "ComfyUI-KJNodes",
      "source": "https://github.com/kijai/ComfyUI-KJNodes",
      "nodes": ["ImageResizeKJv2", "PathchSageAttentionKJ", "VAELoaderKJ", "LTX2MemoryEfficientSageAttentionPatch"],
      "used_by": ["ltx-ripple"],
      "required": true,
      "warning": "On the reference machine these arrive from a locally bundled folder named comfyui-workflow-encrypt. Install KJNodes upstream; the bundled name is not installable."
    },
    {
      "name": "ComfyUI_Res4lyf",
      "source": "https://github.com/ClownsharkBatwing/RES4LYF",
      "nodes": ["Frames Slice"],
      "used_by": ["ltx-ripple"],
      "required": true
    },
    {
      "name": "MiniMaxH3-LatentUpscaler",
      "source": "https://github.com/LBH-123-AI/Comfyui_Minimax_h3_latent_Upscaler",
      "nodes": ["MinimaxH3LatentUpscaler3D"],
      "used_by": ["h3-recast"],
      "required": true,
      "warning": "Two packs of this name are installed on the reference machine. Pin one and assert the resolved python_module at startup."
    }
  ],
  "core_nodes": {
    "note": "Provided by ComfyUI itself; nothing to install. Listed so a version floor can be checked.",
    "from_comfy_extras": [
      "MiniMaxH3ReferenceToVideo", "MiniMaxH3AddGuide",
      "SamplerCustomAdvanced", "BasicGuider", "CFGGuider", "BasicScheduler",
      "KSamplerSelect", "RandomNoise", "SplitSigmas",
      "EmptyLTXVLatentVideo", "LTXVConditioning", "LTXVCropGuides",
      "LTXVConcatAVLatent", "LTXVSeparateAVLatent", "LTXVEmptyLatentAudio",
      "EmptyFlux2LatentImage", "Flux2Scheduler", "ReferenceLatent",
      "VAEDecodeAudio", "BatchImagesNode", "ResizeImageMaskNode",
      "GetImageSize", "ModelAttentionBackend"
    ],
    "from_core": [
      "LoadImage", "UNETLoader", "VAELoader", "CLIPLoader", "CLIPTextEncode",
      "LoraLoaderModelOnly", "VAEDecode", "VAEEncode", "ConditioningZeroOut",
      "ImageScaleToTotalPixels", "SaveImage"
    ]
  },
  "models": [
