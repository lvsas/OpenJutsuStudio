    "diffusion_models": [
      {"file": "flux3-image-klein-int8-convrot.safetensors", "size_gb": 5.83, "note": "distilled, int8 — matches the quantisation the rest of this stack uses"},
      {"file": "flux3-image-klein-bf16.safetensors", "size_gb": 11.1, "note": "distilled, full precision"},
      {"file": "flux3-image-klein-base-int8-convrot.safetensors", "size_gb": 5.81, "note": "base, int8"},
      {"file": "flux3-image-klein-base-bf16.safetensors", "size_gb": 11.08, "note": "base, full precision"},
      {"file": "flux3-image-klein-nvfp4.safetensors", "size_gb": 5.28, "note": "distilled, nvfp4"},
      {"file": "flux3-image-klein-base-nvfp4.safetensors", "size_gb": 5.26, "note": "base, nvfp4"}
    ],
    "text_encoders": [
      {"file": "qwen3.5_9b_flux3_prompt_upsampler_w4a8.safetensors", "size_gb": 6.72, "note": "smallest prompt upsampler"},
      {"file": "qwen3.5_9b_flux3_prompt_upsampler_int8_convrot.safetensors", "size_gb": 9.75},
      {"file": "qwen3.5_9b_flux3_prompt_upsampler_bf16.safetensors", "size_gb": 18.82},
      {"file": "qwen3vl_4b_int8_convrot.safetensors", "size_gb": 4.86, "note": "vision-language encoder, for reading reference images"},
      {"file": "qwen3vl_4b_bf16.safetensors", "size_gb": 8.88}
    ],
    "vae": [
      {"file": "flux2-vae.safetensors", "size_gb": 0.34}
    ],
    "upstream_workflows": [
      "flux3_klein_int8_t2i.json",
      "flux3_klein_int8_i2i.json",
      "flux3_klein_int8_mi2i.json",
      "flux3_klein_base_int8_t2i.json",
      "flux3_klein_base_int8_i2i.json",
      "flux3_klein_base_int8_mi2i.json"
    ],
    "why_this_model": [
      "multi-reference generation is native: it takes several references and keeps characters recognisable across inputs, which is the character-sheet gesture",
      "5.6B parameters, so a reference costs seconds rather than minutes",
      "the same model does text-to-image, single-reference edit and multi-reference composition, so one graph covers the three things the character page needs"
    ]
  }
